# Copiar a config/env.sh, editar y ejecutar: source config/env.sh
# Valores de SQL Warehouses > Connection details. Host sin https://.
export DBT_DATABRICKS_HOST='REEMPLAZAR_HOST'
export DBT_DATABRICKS_HTTP_PATH='/sql/1.0/warehouses/REEMPLAZAR_ID'
export DBT_DATABRICKS_CATALOG='workspace'
export DBT_DATABRICKS_SCHEMA='taller_dbt_analytics'
export DBT_RAW_SCHEMA='taller_dbt_raw'
export DBT_TARGET='dev'
# OAuth abre el navegador. Para PAT, seguir README.md.
