# Copia este archivo:  cp .env.example .env   (el .env NO se sube a Git)

# Linux: el resultado de `id -u`. macOS: puedes dejar 501 o usar `id -u`
AIRFLOW_UID=501

# Tu bucket del notebook 01
AWS_BUCKET=de-tecsup-tualias

# Connection de Airflow "aws_curso" para S3Hook, AthenaOperator, GlueJobOperator...
# Opción A (recomendada): usa el perfil "curso" de ~/.aws (docker-compose lo monta en solo lectura)
AIRFLOW_CONN_AWS_CURSO='{"conn_type": "aws", "extra": {"profile_name": "curso", "region_name": "us-east-2"}}'

# Opción B: si no tienes el perfil, pega aquí la access key del .csv de credentials/
# (comenta la línea de la opción A y descomenta esta)
# AIRFLOW_CONN_AWS_CURSO='{"conn_type": "aws", "login": "<Access key ID>", "password": "<Secret access key>", "extra": {"region_name": "us-east-2"}}'
